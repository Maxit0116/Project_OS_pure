{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Project OS Liquid Glass",
    "version": "3.0.0",
    "description": "Two-tier glass: Tier A frost-chrome (backdrop-filter tokens) for bulk nav; Tier B true lens (GlassScene/GlassLens, Outpace/Aave) for hero overlays. Navigation layer only. Sync to projectos/workbench/src/styles/tokens.css",
    "sources": [
      "https://glass.outpacestudios.com/",
      "https://github.com/haider-nawaz/liquid-glass-skill"
    ]
  },
  "glass": {
    "style": {
      "regular": {
        "description": "Default nav glass — toolbars, sidebars, menus",
        "blur": "md"
      },
      "clear": {
        "description": "High transparency over bold backgrounds — hero areas",
        "blur": "lg"
      },
      "identity": {
        "description": "No glass — a11y fallback, content surfaces",
        "blur": "none"
      }
    },
    "saturate": "200%",
    "blur": { "sm": "16px", "md": "28px", "lg": "40px", "xl": "56px" },
    "bg": {
      "regular": { "dark": "rgba(28, 28, 38, 0.28)", "light": "rgba(255, 255, 255, 0.38)" },
      "clear": { "dark": "rgba(20, 20, 30, 0.14)", "light": "rgba(255, 255, 255, 0.22)" },
      "overlay": { "dark": "rgba(36, 36, 48, 0.48)", "light": "rgba(255, 255, 255, 0.62)" },
      "raised": { "dark": "rgba(28, 28, 38, 0.28)", "light": "rgba(255, 255, 255, 0.38)" },
      "elevated": { "dark": "rgba(32, 32, 44, 0.32)", "light": "rgba(255, 255, 255, 0.48)" }
    },
    "border": {
      "default": { "dark": "rgba(255, 255, 255, 0.2)", "light": "rgba(255, 255, 255, 0.55)" },
      "subtle": { "dark": "rgba(255, 255, 255, 0.1)", "light": "rgba(0, 0, 0, 0.06)" },
      "highlight": { "dark": "rgba(255, 255, 255, 0.38)", "light": "rgba(255, 255, 255, 0.9)" }
    },
    "shadow": {
      "regular": { "dark": "0 1px 0 rgba(255,255,255,0.14) inset, 0 8px 24px rgba(0,0,0,0.28)", "light": "0 1px 0 rgba(255,255,255,0.95) inset, 0 8px 24px rgba(0,0,0,0.1)" },
      "raised": { "dark": "0 1px 0 rgba(255,255,255,0.14) inset, 0 8px 24px rgba(0,0,0,0.28)", "light": "0 1px 0 rgba(255,255,255,0.95) inset, 0 8px 24px rgba(0,0,0,0.1)" },
      "elevated": { "dark": "0 1px 0 rgba(255,255,255,0.2) inset, 0 12px 40px rgba(0,0,0,0.32)", "light": "0 1px 0 rgba(255,255,255,1) inset, 0 12px 40px rgba(0,0,0,0.14)" },
      "overlay": { "dark": "0 1px 0 rgba(255,255,255,0.24) inset, 0 20px 56px rgba(0,0,0,0.44)", "light": "0 1px 0 rgba(255,255,255,1) inset, 0 20px 56px rgba(0,0,0,0.18)" }
    },
    "focusRing": { "dark": "0 0 0 3px rgba(10, 132, 255, 0.45)", "light": "0 0 0 3px rgba(0, 122, 255, 0.35)" }
  },
  "color": {
    "bg": {
      "base": { "dark": "#0a0a0f", "light": "#f2f2f7" },
      "canvas": { "dark": "#0d0d14", "light": "#ffffff" },
      "elevated": { "dark": "rgba(28, 28, 36, 0.92)", "light": "rgba(255, 255, 255, 0.95)" },
      "muted": { "dark": "rgba(44, 44, 54, 0.85)", "light": "rgba(242, 242, 247, 0.95)" }
    },
    "text": {
      "primary": { "dark": "#f5f5f7", "light": "#1d1d1f" },
      "secondary": { "dark": "rgba(245, 245, 247, 0.72)", "light": "rgba(29, 29, 31, 0.72)" },
      "muted": { "dark": "rgba(245, 245, 247, 0.45)", "light": "rgba(29, 29, 31, 0.45)" }
    },
    "accent": {
      "default": { "dark": "#0a84ff", "light": "#007aff" },
      "strong": { "dark": "#409cff", "light": "#0056b3" },
      "subtle": { "dark": "rgba(10, 132, 255, 0.18)", "light": "rgba(0, 122, 255, 0.12)" }
    },
    "semantic": {
      "success": { "dark": "#30d158", "light": "#34c759" },
      "warning": { "dark": "#ffd60a", "light": "#ff9f0a" },
      "error": { "dark": "#ff453a", "light": "#ff3b30" }
    }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "glass": { "sm": "10px", "md": "14px", "lg": "20px", "xl": "28px" },
    "pill": "9999px"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px"
  },
  "typography": {
    "fontSans": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', system-ui, sans-serif",
    "fontMono": "ui-monospace, 'SF Mono', Menlo, monospace",
    "size": { "xs": "11px", "sm": "12px", "md": "13px", "base": "14px", "lg": "16px", "xl": "20px", "2xl": "28px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "motion": {
    "duration": { "fast": "120ms", "normal": "220ms", "slow": "360ms" },
    "ease": {
      "out": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "spring": "cubic-bezier(0.34, 1.28, 0.64, 1)"
    }
  },
  "icon": {
    "size": { "sm": 14, "md": 16, "lg": 20 },
    "strokeWidth": 1.75
  }
}
