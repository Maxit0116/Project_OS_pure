{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["../contracts/*"],
      "@client/*": ["../client/*"]
    }
  },
  "include": [
    "../workbench/src/**/*",
    "../contracts/**/*",
    "../client/**/*",
    "../persistence/**/*",
    "../services/**/*",
    "../utils/**/*",
    "../validation/**/*",
    "../errors.ts"
  ],
  "exclude": [
    "../**/*.test.ts"
  ]
}
