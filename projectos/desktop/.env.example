# GitHub OAuth for desktop.
# Prefer Device Flow with a public OAuth App Client ID.
# If Client ID is unset, Sign in can import an existing `gh auth login` session.

# Optional — OAuth App Client ID (Device Flow; no secret required)
# PROJECTOS_GITHUB_CLIENT_ID=

# Optional — only for PROJECTOS_GITHUB_OAUTH_MODE=loopback
# PROJECTOS_GITHUB_CLIENT_SECRET=

# Optional — force authorize→localhost redirect (needs Client Secret)
# PROJECTOS_GITHUB_OAUTH_MODE=loopback
# PROJECTOS_GITHUB_OAUTH_PORT=38471
