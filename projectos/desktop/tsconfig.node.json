{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./out",
    "rootDir": "..",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "build/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "electron.vite.config.ts",
    "../contracts/**/*",
    "../persistence/**/*",
    "../services/**/*",
    "../utils/**/*",
    "../validation/**/*",
    "../errors.ts"
  ],
  "exclude": [
    "../**/*.test.ts",
    "../**/*.test.tsx"
  ]
}
