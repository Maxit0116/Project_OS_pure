{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["../contracts/*"],
      "@client/*": ["../client/*"]
    }
  },
  "include": [
    "src",
    "../contracts",
    "../client",
    "../client/desktop-bridge.d.ts",
    "../validation/node-compat.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "../contracts/**/*.test.ts",
    "../client/**/*.test.ts"
  ]
}
